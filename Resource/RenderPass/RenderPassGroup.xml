<!-- SamplerState pointSampler : register(s0); -->
<!-- SamplerState bilinearRepeatSampler : register(s1); -->
<!-- Texture2D<float4> gBindlessTextureSRVArray[] : register(t0, BINDLESSTEXTUREARRAY_SPACE); -->
<!-- RWTexture2D<float4> gBindlessTextureUAVArray[] : register(u0, BINDLESSTEXTUREARRAY_SPACE); -->

<RenderPassGroup>
	<RenderTargets>
		<RenderTarget Name="GBuffer" Size="Window">
			<Color Name="Albedo" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Color Name="Normal" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Color Name="Material" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Depth Format="D24_UNORM_S8_UINT" SRV="True"/>
		</RenderTarget>
		<RenderTarget Name="Lighting" Size="Window">
			<Color Name="Color" Format="R32G32B32A32_FLOAT" SRV="True"/>
		</RenderTarget>
		<RenderTarget Name="Atmosphere" Size="Window">
			<Color Name="Color" Format="R32G32B32A32_FLOAT" SRV="True"/>
		</RenderTarget>
		<RenderTarget Name="Bloom" Size="Window">
			<Color Name="Color" Format="R32G32B32A32_FLOAT" SRV="True"/>
		</RenderTarget>
		<RenderTarget Name="SurfaceCapture" Width="512" Height="512">
			<Color Name="Albedo" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Color Name="Normal" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Color Name="Material" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Depth Format="D24_UNORM_S8_UINT" SRV="True"/>
		</RenderTarget>
		<RenderTarget Name="NearShadow0" Width="512" Height="512">
			<Color Name="Albedo" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Color Name="Normal" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Color Name="Material" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Depth Format="D24_UNORM_S8_UINT" SRV="True"/>
		</RenderTarget>
		<RenderTarget Name="NearShadow1" Width="512" Height="512">
			<Color Name="Albedo" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Color Name="Normal" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Color Name="Material" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Depth Format="D24_UNORM_S8_UINT" SRV="True"/>
		</RenderTarget>
		<RenderTarget Name="NearShadow2" Width="512" Height="512">
			<Color Name="Albedo" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Color Name="Normal" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Color Name="Material" Format="R16G16B16A16_FLOAT" SRV="True"/>
			<Depth Format="D24_UNORM_S8_UINT" SRV="True"/>
		</RenderTarget>
		<RenderTarget Name="BackBuffer" Source="SwapChain"/>
	</RenderTargets>

	<RenderPass Name="PathTracing">
		<RaytracingPipeline Name="BruteForce" HitGroup="HitGroup" MaxPayloadSize="24" MaxAttributeSize="8" MaxTraceRecursionDepth="3">
			<Permutation Name="PATHTRACING_MODE" Values="0,1"/>
			<RootConstant Buffer="RaytracingConstants"/>
			<RaygenShader Entry="RayGen">Shader/Raytracing/PathTracingBruteForce.hlsl</RaygenShader>
			<MissShader Entry="Miss">Shader/Raytracing/PathTracingBruteForce.hlsl</MissShader>
			<ClosestHitShader Entry="ClosestHit">Shader/Raytracing/PathTracingBruteForce.hlsl</ClosestHitShader>
		</RaytracingPipeline>
	</RenderPass>

	<RenderPass Name="OceanRenderPass" Target="GBuffer" Load="Clear">
		<ComputePipeline Name="InitialSpectrum">
			<Shader Entry="main">Material/Ocean/InitialSpectrumCS.hlsl</Shader>
		</ComputePipeline>
		<ComputePipeline Name="UpdateSpectrum">
			<Shader Entry="main">Material/Ocean/SpectrumUpdateCS.hlsl</Shader>
		</ComputePipeline>
		<ComputePipeline Name="FFTButterflyHorizontal">
			<RootConstant Buffer="FFTCB"/>
			<Shader Entry="mainHorizontal">Material/Ocean/FFTButterflyCS.hlsl</Shader>
		</ComputePipeline>
		<ComputePipeline Name="FFTButterflyVertical">
			<RootConstant Buffer="FFTCB"/>
			<Shader Entry="mainVertical">Material/Ocean/FFTButterflyCS.hlsl</Shader>
		</ComputePipeline>
		<ComputePipeline Name="Finalize">
			<RootConstant Buffer="FinalizeCB"/>
			<Shader Entry="main">Material/Ocean/FinalizeCS.hlsl</Shader>
		</ComputePipeline>
		<ComputePipeline Name="ComputeOceanNormal">
			<RootConstant Buffer="ComputeOceanNormalCB"/>
			<Shader Entry="main">Material/Ocean/ComputeOceanNormal.hlsl</Shader>
		</ComputePipeline>
		<Pipeline Name="RenderOcean" PrimitiveTopologyType="Triangle" DepthEnable="True" FillMode="Solid" CullMode="Back">
			<LayoutInfo>
				<Element Type="float2">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material/Ocean/RenderOcean.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material/Ocean/RenderOcean.hlsl</PixelShader>
		</Pipeline>
	</RenderPass>

	<RenderPass Name="MainRenderPass" Target="GBuffer" Load="Load">
		<!-- <Pipeline Name="SkyDomePipeline" PrimitiveTopologyType="Triangle" DepthEnable="False" FillMode="WireFrame" CullMode="Front">
			<LayoutInfo>
				<Element Type="float3">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material/SkyDome.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material/SkyDome.hlsl</PixelShader>
		</Pipeline> -->
		<Pipeline Name="TerrainClipmapPipeline" PrimitiveTopologyType="Triangle" DepthEnable="True" FillMode="Solid" CullMode="Back">
			<LayoutInfo>
				<Element Type="float2">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material\TerrainClipMap.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material\TerrainClipMap.hlsl</PixelShader>
		</Pipeline>

		<Pipeline Name="GrassPatchPipeline" PrimitiveTopologyType="Triangle" DepthEnable="True" FillMode="Solid" CullMode="None">
			<RootConstant Buffer="GrassPatchConstants"/>
			<VertexShader Entry="VSMain">Material\GrassPatch.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material\GrassPatch.hlsl</PixelShader>
		</Pipeline>

		<Pipeline Name="StaticMeshStandardPipeline" PrimitiveTopologyType="Triangle" DepthEnable="True" FillMode="Solid" CullMode="Back">
			<LayoutInfo>
				<Element Type="float3">POSITION</Element>
				<Element Type="float3">NORMAL</Element>
				<Element Type="float2">TEXCOORD</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material\StaticMeshStandard.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material\StaticMeshStandard.hlsl</PixelShader>
		</Pipeline>

		<Pipeline Name="SkinnedMeshStandardPipeline" PrimitiveTopologyType="Triangle" DepthEnable="True" FillMode="Solid" CullMode="Back">
			<LayoutInfo>
				<Element Type="float3">POSITION</Element>
				<Element Type="float3">NORMAL</Element>
				<Element Type="float2">TEXCOORD</Element>
				<Element Type="uint4">BONEINDEXES</Element>
				<Element Type="float4">BONEWEIGHTS</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material\SkinnedMeshStandard.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material\SkinnedMeshStandard.hlsl</PixelShader>
		</Pipeline>

		<Pipeline Name="SpherePipeline" PrimitiveTopologyType="Triangle" DepthEnable="False" FillMode="Solid" CullMode="Back">
			<LayoutInfo>
				<Element Type="float3">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMainSphere">Material\DebugDrawElement.hlsl</VertexShader>
			<PixelShader Entry="PSMainSphere">Material\DebugDrawElement.hlsl</PixelShader>
		</Pipeline>
		<Pipeline Name="LinePipeline" PrimitiveTopologyType="Line" DepthEnable="False" FillMode="Solid" CullMode="None">
			<LayoutInfo>
				<Element Type="float3">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMainLine">Material\DebugDrawElement.hlsl</VertexShader>
			<PixelShader Entry="PSMainLine">Material\DebugDrawElement.hlsl</PixelShader>
		</Pipeline>
	</RenderPass>

    <RenderPass Name="AtmosphereTransmittancePass">
        <ComputePipeline Name="AtmosphereTransmittancePipeline">
            <RootConstant Buffer="AtmosphereLutOutputConstants"/>
            <Shader Entry="CSMain">Material/Atmosphere/AtmosphereTransmittanceCS.hlsl</Shader>
        </ComputePipeline>
    </RenderPass>

    <RenderPass Name="AtmosphereMultipleScatteringPass">
        <ComputePipeline Name="AtmosphereMultipleScatteringPipeline">
            <RootConstant Buffer="MultipleScatteringOutputConstants"/>
            <Shader Entry="CSMain">Material/Atmosphere/AtmosphereMultipleScatteringCS.hlsl</Shader>
        </ComputePipeline>
    </RenderPass>
    <RenderPass Name="AtmosphereSurfaceBouncePass">
        <ComputePipeline Name="AtmosphereSurfaceBouncePipeline">
            <RootConstant Buffer="SurfaceBounceOutputConstants"/>
            <Shader Entry="CSMain">Material/Atmosphere/AtmosphereSurfaceBounceCS.hlsl</Shader>
        </ComputePipeline>
    </RenderPass>
	<RenderPass Name="AtmosphereSkyLightingPass">
        <ComputePipeline Name="AtmosphereSkyRadiancePipeline">
            <RootConstant Buffer="SkyLightingOutputConstants"/>
            <Shader Entry="CSRadiance">Material/Atmosphere/AtmosphereSkyLightingCS.hlsl</Shader>
        </ComputePipeline>
        <ComputePipeline Name="AtmosphereSkyFilterPipeline">
            <RootConstant Buffer="SkyLightingOutputConstants"/>
            <Shader Entry="CSFilter">Material/Atmosphere/AtmosphereSkyLightingCS.hlsl</Shader>
        </ComputePipeline>
    </RenderPass>
    <RenderPass Name="AtmosphereRenderPass" Target="Atmosphere" Load="Load">
		<Pipeline Name="AtmospherePipeline" PrimitiveTopologyType="Triangle" DepthEnable="False" FillMode="Solid">
			<RootConstant Buffer="AtmosphereInputConstants"/>
			<LayoutInfo>
				<Element Type="float2">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material\Atmosphere\Atmosphere.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material\Atmosphere\Atmosphere.hlsl</PixelShader>
		</Pipeline>
	</RenderPass>

	<RenderPass Name="FinalOutputRenderPass" Target="BackBuffer" Load="Load">
		<Pipeline Name="FinalOutputPipeline" PrimitiveTopologyType="Triangle" DepthEnable="False" FillMode="Solid">
			<RootConstant Buffer="FinalOutputConstants"/>
			<LayoutInfo>
				<Element Type="float2">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material\FinalOutput.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material\FinalOutput.hlsl</PixelShader>
		</Pipeline>
	</RenderPass>
	<RenderPass Name="BloomHorizontalRenderPass" Target="Lighting" Load="Load">
		<Pipeline Name="BloomHorizontalPipeline" PrimitiveTopologyType="Triangle" DepthEnable="False" FillMode="Solid">
			<RootConstant Buffer="BloomInputConstants"/>
			<LayoutInfo>
				<Element Type="float2">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material/Bloom.hlsl</VertexShader>
			<PixelShader Entry="PSHorizontal">Material/Bloom.hlsl</PixelShader>
		</Pipeline>
	</RenderPass>
	<RenderPass Name="BloomVerticalRenderPass" Target="Bloom" Load="Load">
		<Pipeline Name="BloomVerticalPipeline" PrimitiveTopologyType="Triangle" DepthEnable="False" FillMode="Solid">
			<RootConstant Buffer="BloomInputConstants"/>
			<LayoutInfo>
				<Element Type="float2">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material/Bloom.hlsl</VertexShader>
			<PixelShader Entry="PSVertical">Material/Bloom.hlsl</PixelShader>
		</Pipeline>
	</RenderPass>
	<RenderPass Name="GBufferRenderPass" Target="Lighting" Load="Load">
		<Pipeline Name="GBufferPipeline" PrimitiveTopologyType="Triangle" DepthEnable="False" FillMode="Solid">
			<RootConstant Buffer="GBufferConstants"/>
			<LayoutInfo><Element Type="float2">POSITION</Element></LayoutInfo>
			<VertexShader Entry="VSMain">Material/GBuffer.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material/GBuffer.hlsl</PixelShader>
		</Pipeline>
	</RenderPass>

	<RenderPassInstance Name="MainGeometryClearPass" Pass="MainRenderPass" Target="GBuffer" Load="Clear"/>
	<RenderPassInstance Name="SurfaceCapturePass" Pass="MainRenderPass" Target="SurfaceCapture" Load="Clear" Store="ShaderRead"/>
	<RenderPassInstance Name="NearShadowPass0" Pass="MainRenderPass" Target="NearShadow0" Load="Clear" Store="ShaderRead"/>
	<RenderPassInstance Name="NearShadowPass1" Pass="MainRenderPass" Target="NearShadow1" Load="Clear" Store="ShaderRead"/>
	<RenderPassInstance Name="NearShadowPass2" Pass="MainRenderPass" Target="NearShadow2" Load="Clear" Store="ShaderRead"/>
</RenderPassGroup>
