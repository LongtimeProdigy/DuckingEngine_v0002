<!-- SamplerState pointSampler : register(s0); -->
<!-- SamplerState bilinearRepeatSampler : register(s1); -->
<!-- Texture2D<float4> gBindlessTextureSRVArray[] : register(t0, BINDLESSTEXTUREARRAY_SPACE); -->
<!-- RWTexture2D<float4> gBindlessTextureUAVArray[] : register(u0, BINDLESSTEXTUREARRAY_SPACE); -->

<RenderPassGroup>
	<RenderPass Name="PathTracing">
		<RaytracingPipeline Name="BruteForce">
			<RootConstant Buffer="RaytracingConstants"/>
			<RaygenShader Entry="RayGen">Shader/Raytracing/PathTracingBruteForce.hlsl</RaygenShader>
			<MissShader Entry="Miss">Shader/Raytracing/PathTracingBruteForce.hlsl</MissShader>
			<ClosestHitShader Entry="ClosestHit">Shader/Raytracing/PathTracingBruteForce.hlsl</ClosestHitShader>
		</RaytracingPipeline>
	</RenderPass>

	<RenderPass Name="OceanRenderPass">
		<ComputePipeline Name="InitialSpectrum">
			<Shader Entry="main">Material/Ocean/InitialSpectrumCS.hlsl</Shader>
		</ComputePipeline>
		<ComputePipeline Name="UpdateSpectrum">
			<Shader Entry="main">Material/Ocean/SpectrumUpdateCS.hlsl</Shader>
		</ComputePipeline>
		<ComputePipeline Name="FFTButterflyHorizontal">
			<RootConstant Buffer="FFTCB"/>
			<Shader Entry="mainHorizontal">Material/Ocean/FFTButterflyCS.hlsl</Shader>
		</ComputePipeline>
		<ComputePipeline Name="FFTButterflyVertical">
			<RootConstant Buffer="FFTCB"/>
			<Shader Entry="mainVertical">Material/Ocean/FFTButterflyCS.hlsl</Shader>
		</ComputePipeline>
		<ComputePipeline Name="Finalize">
			<RootConstant Buffer="FinalizeCB"/>
			<Shader Entry="main">Material/Ocean/FinalizeCS.hlsl</Shader>
		</ComputePipeline>
		<ComputePipeline Name="ComputeOceanNormal">
			<RootConstant Buffer="ComputeOceanNormalCB"/>
			<Shader Entry="main">Material/Ocean/ComputeOceanNormal.hlsl</Shader>
		</ComputePipeline>
		<Pipeline Name="RenderOcean" PrimitiveTopologyType="Triangle" DepthEnable="True" FillMode="Solid" CullMode="Back">
			<LayoutInfo>
				<Element Type="float2">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material/Ocean/RenderOcean.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material/Ocean/RenderOcean.hlsl</PixelShader>
		</Pipeline>
	</RenderPass>

	<RenderPass Name="MainRenderPass">
		<!-- <Pipeline Name="SkyDomePipeline" PrimitiveTopologyType="Triangle" DepthEnable="False" FillMode="WireFrame" CullMode="Front">
			<LayoutInfo>
				<Element Type="float3">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material/SkyDome.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material/SkyDome.hlsl</PixelShader>
		</Pipeline> -->
		<Pipeline Name="TerrainClipmapPipeline" PrimitiveTopologyType="Triangle" DepthEnable="True" FillMode="Solid" CullMode="Back">
			<LayoutInfo>
				<Element Type="float2">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material\TerrainClipMap.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material\TerrainClipMap.hlsl</PixelShader>
		</Pipeline>

		<Pipeline Name="StaticMeshStandardPipeline" PrimitiveTopologyType="Triangle" DepthEnable="True" FillMode="Solid" CullMode="Back">
			<LayoutInfo>
				<Element Type="float3">POSITION</Element>
				<Element Type="float3">NORMAL</Element>
				<Element Type="float2">TEXCOORD</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material\StaticMeshStandard.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material\StaticMeshStandard.hlsl</PixelShader>
		</Pipeline>

		<Pipeline Name="SkinnedMeshStandardPipeline" PrimitiveTopologyType="Triangle" DepthEnable="True" FillMode="Solid" CullMode="Back">
			<LayoutInfo>
				<Element Type="float3">POSITION</Element>
				<Element Type="float3">NORMAL</Element>
				<Element Type="float2">TEXCOORD</Element>
				<Element Type="uint4">BONEINDEXES</Element>
				<Element Type="float4">BONEWEIGHTS</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material\SkinnedMeshStandard.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material\SkinnedMeshStandard.hlsl</PixelShader>
		</Pipeline>

		<Pipeline Name="SpherePipeline" PrimitiveTopologyType="Triangle" DepthEnable="False" FillMode="Solid" CullMode="Back">
			<LayoutInfo>
				<Element Type="float3">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMainSphere">Material\DebugDrawElement.hlsl</VertexShader>
			<PixelShader Entry="PSMainSphere">Material\DebugDrawElement.hlsl</PixelShader>
		</Pipeline>
		<Pipeline Name="LinePipeline" PrimitiveTopologyType="Line" DepthEnable="False" FillMode="Solid" CullMode="None">
			<LayoutInfo>
				<Element Type="float3">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMainLine">Material\DebugDrawElement.hlsl</VertexShader>
			<PixelShader Entry="PSMainLine">Material\DebugDrawElement.hlsl</PixelShader>
		</Pipeline>
	</RenderPass>

	<RenderPass Name="AtmosphereRenderPass">
		<Pipeline Name="AtmospherePipeline" PrimitiveTopologyType="Triangle" DepthEnable="False" FillMode="Solid">
			<LayoutInfo>
				<Element Type="float2">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material\Atmosphere.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material\Atmosphere.hlsl</PixelShader>
		</Pipeline>
	</RenderPass>

	<RenderPass Name="GBufferRenderPass">
		<Pipeline Name="GBufferPipeline" PrimitiveTopologyType="Triangle" DepthEnable="False" FillMode="Solid">
			<LayoutInfo>
				<Element Type="float2">POSITION</Element>
			</LayoutInfo>
			<VertexShader Entry="VSMain">Material\GBuffer.hlsl</VertexShader>
			<PixelShader Entry="PSMain">Material\GBuffer.hlsl</PixelShader>
		</Pipeline>
	</RenderPass>
</RenderPassGroup>